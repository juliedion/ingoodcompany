<!-- WEBSITES PAGE -->

<div class="page-header">
  <span class="eyebrow page-header__eyebrow">Creative Services</span>
  <h1 class="page-header__title">Website Design & Development</h1>
  <p class="page-header__desc">Beautiful, strategic websites that work as hard as you do — from simple landing pages to full e-commerce stores.</p>
</div>

<!-- What's Included -->
<section class="section section--cream">
  <div class="container">
    <div class="section__header">
      <span class="eyebrow">Our Approach</span>
      <h2>Websites Built With Purpose</h2>
      <p>Every site we build is custom-designed, mobile-optimized, and crafted to grow your business.</p>
    </div>
    <div class="grid grid--3">
      <div class="service-card">
        <div class="service-card__icon">🎨</div>
        <div class="service-card__title">Custom Design</div>
        <p class="service-card__desc">Your brand, your vision — brought to life with a design that's uniquely yours. No templates, no cookie-cutter.</p>
      </div>
      <div class="service-card">
        <div class="service-card__icon">🛒</div>
        <div class="service-card__title">Shopify Stores</div>
        <p class="service-card__desc">Full e-commerce setup including product listings, payment integration, and custom theme design.</p>
      </div>
      <div class="service-card">
        <div class="service-card__icon">📱</div>
        <div class="service-card__title">Mobile-First</div>
        <p class="service-card__desc">Every site is fully responsive and optimized for phones, tablets, and desktops right out of the box.</p>
      </div>
      <div class="service-card">
        <div class="service-card__icon">🔍</div>
        <div class="service-card__title">SEO Ready</div>
        <p class="service-card__desc">Built with SEO best practices from the ground up so your customers can find you on Google.</p>
      </div>
      <div class="service-card">
        <div class="service-card__icon">⚡</div>
        <div class="service-card__title">Fast & Reliable</div>
        <p class="service-card__desc">Optimized for speed and performance. Because nobody waits for a slow website.</p>
      </div>
      <div class="service-card">
        <div class="service-card__icon">🛠️</div>
        <div class="service-card__title">Ongoing Support</div>
        <p class="service-card__desc">Monthly maintenance, updates, and support available so your site stays fresh and functional.</p>
      </div>
    </div>
  </div>
</section>

<!-- Pricing Tiers -->
<section class="section section--lg">
  <div class="container">
    <div class="section__header">
      <span class="eyebrow">Website Packages</span>
      <h2>Find Your Perfect Plan</h2>
      <p>Transparent pricing. No surprises. Every package includes a consultation to make sure we're the right fit.</p>
    </div>

    <div class="tiers">

      <div class="tier-card">
        <div class="tier-card__name">Starter</div>
        <div class="tier-card__price"><sup>$</sup>499</div>
        <div class="tier-card__period">one-time</div>
        <ul class="tier-card__features">
          <li>Up to 5 pages</li>
          <li>Mobile responsive design</li>
          <li>Contact form</li>
          <li>Basic SEO setup</li>
          <li>Social media links</li>
          <li>2 rounds of revisions</li>
          <li>Launch support</li>
        </ul>
        <a href="/pages/contact" class="btn btn--outline" style="text-align:center; justify-content:center;">Get Started</a>
      </div>

      <div class="tier-card tier-card--featured">
        <div class="tier-card__badge">Most Popular</div>
        <div class="tier-card__name">Growth</div>
        <div class="tier-card__price"><sup>$</sup>999</div>
        <div class="tier-card__period">one-time + optional monthly support</div>
        <ul class="tier-card__features">
          <li>Up to 12 pages</li>
          <li>Custom brand design</li>
          <li>Blog or portfolio setup</li>
          <li>SEO optimization</li>
          <li>Google Analytics</li>
          <li>Email opt-in integration</li>
          <li>3 rounds of revisions</li>
          <li>30-day post-launch support</li>
        </ul>
        <a href="/pages/contact" class="btn btn--gold" style="text-align:center; justify-content:center;">Get Started</a>
      </div>

      <div class="tier-card">
        <div class="tier-card__name">Shopify Pro</div>
        <div class="tier-card__price"><sup>$</sup>1,799</div>
        <div class="tier-card__period">one-time</div>
        <ul class="tier-card__features">
          <li>Full Shopify store setup</li>
          <li>Custom theme design</li>
          <li>Up to 50 products loaded</li>
          <li>Payment & shipping setup</li>
          <li>Email marketing integration</li>
          <li>SEO + analytics</li>
          <li>4 rounds of revisions</li>
          <li>60-day support</li>
        </ul>
        <a href="/pages/contact" class="btn btn--outline" style="text-align:center; justify-content:center;">Get Started</a>
      </div>

      <div class="tier-card">
        <div class="tier-card__name">Monthly Care</div>
        <div class="tier-card__price"><sup>$</sup>149</div>
        <div class="tier-card__period">per month</div>
        <ul class="tier-card__features">
          <li>Content updates (up to 4/mo)</li>
          <li>Plugin & security updates</li>
          <li>Performance monitoring</li>
          <li>Monthly report</li>
          <li>Priority email support</li>
          <li>Cancel anytime</li>
        </ul>
        <a href="/pages/contact" class="btn btn--outline" style="text-align:center; justify-content:center;">Add to Any Plan</a>
      </div>

    </div>

    <p style="text-align:center; color:var(--clr-brown-light); margin-top:2rem; font-size:0.9rem;">
      Need something custom? <a href="/pages/contact" style="color:var(--clr-green); font-weight:600;">Let's talk</a> — every project is unique and we love a good challenge.
    </p>
  </div>
</section>

<!-- Process -->
<section class="section section--cream">
  <div class="container">
    <div class="section__header">
      <span class="eyebrow">How It Works</span>
      <h2>Our Process</h2>
    </div>
    <div class="grid grid--4">
      {%- assign steps = "Discovery Call|We learn about your business, goals, and vision.,Design Concepts|You receive 2-3 initial concepts to choose from.,Build & Refine|We build your site with your feedback along the way.,Launch|Your site goes live — and we celebrate with you!" | split: ',' -%}
      {%- assign step_num = 1 -%}
      {%- for step in steps -%}
        {%- assign parts = step | split: '|' -%}
        <div style="text-align:center; padding:1.5rem;">
          <div style="width:52px; height:52px; background:var(--clr-green); color:#fff; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:var(--font-display); font-size:1.3rem; margin:0 auto 1rem;">{{ step_num }}</div>
          <h4 style="font-family:var(--font-heading); margin-bottom:0.5rem;">{{ parts[0] }}</h4>
          <p style="font-size:0.88rem; color:var(--clr-brown-light);">{{ parts[1] }}</p>
        </div>
        {%- assign step_num = step_num | plus: 1 -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section section--dark" style="text-align:center;">
  <div class="container--narrow">
    <span class="eyebrow" style="color:var(--clr-sand);">Ready to Start?</span>
    <h2 style="color:#fff; margin-bottom:1rem;">Let's Build Something You're Proud Of</h2>
    <p style="color:var(--clr-brown-light); margin-bottom:2rem;">Schedule a free 30-minute consultation — no commitment required.</p>
    <a href="/pages/contact" class="btn btn--gold">Book a Free Consultation</a>
  </div>
</section>
